# Gateway
PORT=8080
MCP_WRAPPER_IDLE_MINUTES=15
MCP_PROTOCOL_VERSION=2024-11-05

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Optional: absolute URLs in GET / markdown catalog
# PUBLIC_BASE_URL=https://mcp.example.com

# Bind sessions to a verified identity supplied by the authenticating reverse proxy.
# Strip client-supplied copies of this header at the proxy.
# MCP_WRAPPER_TRUSTED_USER_HEADER=x-authenticated-user
# MCP_WRAPPER_MAX_INSTANCES=100
# MCP_WRAPPER_MAX_SESSIONS=100
# MCP_WRAPPER_MAX_BODY_BYTES=1048576
# MCP_WRAPPER_MAX_MESSAGE_BYTES=1048576
# MCP_WRAPPER_MAX_PENDING_REQUESTS=128
# MCP_WRAPPER_REQUEST_TIMEOUT_MS=30000
# MCP_WRAPPER_MAX_SSE_STREAMS=4
